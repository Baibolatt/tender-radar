# Скопируйте этот файл в .env и заполните своими значениями.
# Настоящие ключи в git не попадают.

BOT_TOKEN=

# Ключ Google Gemini API: получите бесплатно на https://aistudio.google.com
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Модель: gemini-3.1-flash-lite — работает на бесплатном тарифе.
# Pro-модели (gemini-3.1-pro-preview и т.п.) требуют подключённой оплаты.
AI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_SECONDS=20
# Сколько повторов после первой попытки (всего попыток: 1 + это число)
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_SECONDS=1
AI_MAX_TOKENS=300

# Необязательные настройки (уберите #, чтобы включить)
# FLORIST_CHAT_ID=123456789

STORE_CODE=TR
TIMEZONE=Asia/Almaty
DATABASE_PATH=data/bot.db
LOG_LEVEL=INFO

# Каталог и сроки
READY_MINUTES=60
CATALOG_PAGE_SIZE=5

# Панель заказов флориста
PANEL_PASSWORD=
PANEL_HOST=127.0.0.1
PANEL_PORT=8000

MAX_RESPONSE_CHARS=900
MAX_INPUT_CHARS=2000
HANDOFF_COOLDOWN_MINUTES=30

# Формулировать вопросы заказа через ИИ (true/false)
AI_STEP_QUESTIONS=true
